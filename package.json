{
  "name": "duckdb-wasm-demo",
  "version": "1.0.0",
  "private": true,
  "description": "DuckDB-Wasm 浏览器示例：CSV/Excel 导入与亚马逊运营分析",
  "type": "module",
  "scripts": {
    "prestart": "echo '\\n>>> 请打开终端提示的 Local 地址，并强制刷新 Cmd+Shift+R\\n'",
    "dev": "vite --port 5173 --strictPort --force",
    "start": "vite --port 5173 --strictPort --force",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173"
  },
  "keywords": [
    "duckdb",
    "duckdb-wasm",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "5.8",
    "vite": "^6.0.0"
  }
}
